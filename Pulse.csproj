<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\Icons\pulse.ico</ApplicationIcon>

    <!-- Our own Main, in Program.cs, instead of the one generated from App.xaml. The sensor
         host is a second copy of this exe with no UI at all, and the generated entry point
         builds the Application and loads every merged resource dictionary before reaching any
         of our code. This lets the host skip all of it. -->
    <StartupObject>Pulse.Program</StartupObject>
    <Version>1.3.3</Version>
    <Company>Refora Technologies</Company>
    <Product>Pulse</Product>
    <Copyright>© 2025 Refora Technologies</Copyright>
    <!-- Off on purpose: the five native WPF libraries ship beside Pulse.exe in Program Files and
         setup.iss installs them. Bundled, they were unpacked to %TEMP%\.net\Pulse\<hash> and
         loaded from there, and that folder is not Pulse's to keep. On the owner's laptop four of
         the five kept disappearing between sessions, eight times in four weeks to 16 Oct 2026,
         and each time the overlay or the shortcuts failed to start until Pulse was restarted.
         It was also a folder any program running as the user can write to, loaded by a process
         running as administrator. Program Files is neither cleaned nor writable. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Off on purpose. Compressed, every Pulse process unpacked the whole runtime into its own
         private memory: measured 13 Oct 2026, about 250 MB for the main process and 125 MB for
         the sensor host. Uncompressed, Windows maps the code from the file and shares it: 148 and
         73 MB, starting as fast or faster. The installer compresses everything anyway and does it
         better on code that is not already compressed, so the download shrank from 77 to 57 MB.
         The cost is the exe on disk, 79 MB to 181 MB. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Pinned rather than left to the SDK.
         Pulse ships self-contained, so whatever runtime is bundled here is the runtime our
         users get — the SDK would otherwise embed the newest patch it happens to know about,
         which was once two security patches behind. Pulse runs elevated, so shipping a stale
         runtime matters more than it would for an ordinary app.
         Bump this when a new 10.0.x patch is published. -->
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\**" />
    <Resource Include="Resources\Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled as a loose file (not a WPF-embedded Resource) since it has to be
         launched as a real external process, not read from within the assembly. -->
    <None Include="Resources\PresentMon\PresentMon-2.5.1-x64.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
