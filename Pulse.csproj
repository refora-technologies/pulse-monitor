<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\Icons\pulse.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <Company>Refora Technologies</Company>
    <Product>Pulse</Product>
    <Copyright>© 2025 Refora Technologies</Copyright>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Pinned rather than left to the SDK.
         Pulse ships self-contained, so whatever runtime is bundled here is the runtime our
         users get — the SDK would otherwise embed the newest patch it happens to know about,
         which was 8.0.28 and two security patches behind. Pulse runs elevated, so shipping a
         stale runtime matters more than it would for an ordinary app.
         Bump this when a new 8.0.x patch is published. -->
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\**" />
    <Resource Include="Resources\Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled as a loose file (not a WPF-embedded Resource) since it has to be
         launched as a real external process, not read from within the assembly. -->
    <None Include="Resources\PresentMon\PresentMon-2.5.1-x64.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
