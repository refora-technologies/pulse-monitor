<Window x:Class="Pulse.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's New"
        Width="520" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>

        <!-- Thin scrollbar, floating so it never changes the content width -->
        <Style x:Key="NotesScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Background="#2E2952" MinHeight="28"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar HorizontalAlignment="Right" x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource NotesScrollBar}" Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogAccentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="20,11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A78BFA" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#8E8AB0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,11"
                                Background="#0E0C1C" BorderBrush="#241F42" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A2870"/>
                                <Setter Property="Foreground" Value="#C4B5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="17" BorderThickness="1" BorderBrush="#241F42"
            TextElement.FontFamily="{StaticResource Jakarta}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#15111F" Offset="0"/>
                <GradientStop Color="#0B0A14" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.5" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Grid.Row="0" Margin="24,22,24,14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="UPDATE AVAILABLE" FontSize="10" FontWeight="Bold"
                               Foreground="#A9A4CE" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="What's New in " FontSize="21" FontWeight="ExtraBold"
                               Foreground="#F0EEF8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" FontSize="21" FontWeight="ExtraBold"
                               Foreground="#A78BFA" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SizeText" FontSize="10.5" FontWeight="Medium"
                           Foreground="#8B86B4" Margin="0,5,0,0"/>
                <Border Height="1" Background="#1A1830" Margin="0,16,0,0"/>
            </StackPanel>

            <!-- ═══ RELEASE NOTES ═══ -->
            <!-- Hidden rather than Auto: the notes are short, and a bar appearing partway
                 through reading them shifts the text sideways. Wheel and keyboard
                 scrolling still work. -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="NotesScroller" VerticalScrollBarVisibility="Hidden"
                              Margin="24,0,20,0" ScrollChanged="NotesScroller_ScrollChanged">
                    <StackPanel x:Name="NotesPanel" Margin="0,2,6,10"/>
                </ScrollViewer>

                <!-- With the scrollbar hidden there is nothing to say more text exists below,
                     so this appears only while there is somewhere left to scroll. The fade
                     behind it hints that the text continues rather than ends. -->
                <Border x:Name="ScrollHint" Height="46" VerticalAlignment="Bottom"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000E0C1C" Offset="0"/>
                            <GradientStop Color="#CC0E0C1C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#A78BFA" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.9"/>
                </Border>
            </Grid>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="2" CornerRadius="0,0,17,17" Padding="24,16"
                    BorderBrush="#1A1830" BorderThickness="0,1,0,0">
                <Border.Background><SolidColorBrush Color="#0B0A14" Opacity="0.85"/></Border.Background>
                <Grid>
                    <Button Content="Not now" HorizontalAlignment="Left"
                            Style="{StaticResource DialogGhostBtn}" Click="BtnLater_Click"/>
                    <Button x:Name="BtnDownload" Content="Download and Install"
                            HorizontalAlignment="Right"
                            Style="{StaticResource DialogAccentBtn}" Click="BtnDownload_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
