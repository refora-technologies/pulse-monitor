<Window x:Class="Pulse.Views.SensorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Pulse.Converters"
        xmlns:local="clr-namespace:Pulse.Views"
        Title="Pulse — Sensors"
        Width="1100" Height="740"
        MinWidth="800" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- The Sensors window (owner's choice of the mockups, 26 Nov 2026): the parts of the PC down
         the left, an overview of every part as the front page, and for each part its main reading
         in a large graph, Pulse's own readings with their overlay switches, then every sensor it
         reports, grouped by kind.

         The look (26 Nov 2026): near-neutral surfaces, Pulse's
         violet only as the accent (selection, switches that are on, the graph being looked at),
         three text levels, tabular numbers, structure from spacing and hairlines rather than
         boxes inside boxes. -->

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Views/PulseStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVis"/>

        <!-- ═══ COLOURS (DESIGN-NOTES.md) ═══ -->
        <SolidColorBrush x:Key="Base"     Color="#0E0E13"/>
        <SolidColorBrush x:Key="Raised"   Color="#15151B"/>
        <SolidColorBrush x:Key="Raised2"  Color="#1C1C24"/>
        <SolidColorBrush x:Key="Inset"    Color="#0A0A0E"/>
        <SolidColorBrush x:Key="Line"     Color="#23232C"/>
        <SolidColorBrush x:Key="LineSoft" Color="#1B1B22"/>
        <SolidColorBrush x:Key="Text1"    Color="#ECECF1"/>
        <SolidColorBrush x:Key="Text2"    Color="#A1A1AD"/>
        <SolidColorBrush x:Key="Text3"    Color="#6C6C78"/>
        <SolidColorBrush x:Key="Accent"   Color="#A78BFA"/>
        <SolidColorBrush x:Key="Quiet"    Color="#7A7A86"/>

        <!-- Keyboard focus only: a click does not leave an outline behind. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" RadiusX="8" RadiusY="8" Stroke="#C4B5FD" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SMALL SWITCH ═══ -->
        <Style x:Key="MiniToggle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Drawn 30 by 17, but takes a click 38 by 29 (owner, 27 Nov 2026: controls
                             too low to hit). The negative margin keeps the rows the size they were. -->
                        <Grid Background="Transparent" Margin="-4,-6">
                            <Grid Width="30" Height="17" Margin="4,6">
                                <Border x:Name="Track" CornerRadius="8.5" BorderThickness="1" Background="#1E1E26" BorderBrush="#30303A"/>
                                <Border x:Name="Thumb" Width="11" Height="11" CornerRadius="5.5" Background="#7A7A86"
                                        HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#4A4A56"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="16,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SIDEBAR ENTRY: a raised fill and a violet tick when selected (Tag="True") ═══ -->
        <Style x:Key="SideItem" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Tick" Width="2" Height="14" CornerRadius="1" Background="{StaticResource Accent}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16161C"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised2}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ OVERVIEW CARD (a button: opens the part) ═══ -->
        <Style x:Key="PartCardBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" Padding="16,14,16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34343F"/>
                                <Setter TargetName="Bd" Property="Background" Value="#17171E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        </Style>
        <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Shown only while the item is, for the search. -->
        <Style x:Key="ShownWhileVisible" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </Style>

        <!-- ═══ ONE OF PULSE'S READINGS: value, last minute, switches ═══
             The switches are the tile lists' own items (TileSelectionItem), so this window and
             the lists cannot disagree. -->
        <DataTemplate x:Key="ReadingCard">
            <Border x:Name="Card" Margin="0,0,8,8" CornerRadius="8" Background="{StaticResource Raised}"
                    Padding="14,11,14,10" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Advanced" FontSize="9.5" FontWeight="Medium"
                                   Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                                   Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Text2}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Margin="0,2,0,6" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Value, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{Binding ValueBrush, Mode=OneWay}"/>
                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Text3}"/>
                    </TextBlock>
                    <local:Sparkline Grid.Row="2" Values="{Binding History}" Minimum="{Binding GraphMin}" Maximum="{Binding GraphMax}"
                                     Stroke="{StaticResource Quiet}"
                                     Visibility="{Binding IsCores, Converter={StaticResource InverseBoolToVis}}"/>
                    <local:CoreBars Grid.Row="2" Loads="{Binding CoreLoads}" BarWidth="5" HorizontalAlignment="Left"
                                    Visibility="{Binding IsCores, Converter={StaticResource BoolToVis}}"/>
                    <Grid Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource MiniToggle}" IsChecked="{Binding Overlay.IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} on the overlay'}"/>
                            <TextBlock Text="Overlay" FontSize="10.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                    <Binding Path="DataContext.ShowInGameSwitches" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="HasInGame"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <CheckBox Style="{StaticResource MiniToggle}" IsChecked="{Binding InGame.IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} in game'}"/>
                            <TextBlock Text="In game" FontSize="10.5" Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,10,0,1" Text="Not on this PC" FontSize="10.5" Foreground="{StaticResource Text3}"
                               ToolTip="{Binding Unavailable}"
                               Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ ONE SENSOR ROW ═══ -->
        <DataTemplate x:Key="SensorRowTemplate">
            <Border x:Name="Row" Padding="16,5,12,5" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text1}"/>
                        <Run Text="{Binding Tile, Mode=OneWay}" Foreground="{StaticResource Accent}" FontSize="10.5"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Run Text="{Binding Now, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="10" Foreground="{StaticResource Text3}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Low}" FontSize="12" Foreground="{StaticResource Text3}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding High}" FontSize="12" Foreground="{StaticResource Text3}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <local:Sparkline Grid.Column="4" Values="{Binding History}" Height="16" Margin="20,0,4,0"
                                     Stroke="{StaticResource Quiet}"/>
                    <CheckBox x:Name="OverlaySwitch" Grid.Column="5" Style="{StaticResource MiniToggle}" HorizontalAlignment="Center"
                              IsChecked="{Binding Reading.Overlay.IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Reading.Label, StringFormat='{}{0} on the overlay'}"/>
                    <CheckBox x:Name="InGameSwitch" Grid.Column="6" Style="{StaticResource MiniToggle}" HorizontalAlignment="Center"
                              IsChecked="{Binding Reading.InGame.IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Reading.Label, StringFormat='{}{0} in game'}">
                        <CheckBox.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                <Binding Path="DataContext.ShowInGameSwitches" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="Reading.IsAvailable"/>
                                <Binding Path="Reading.HasInGame"/>
                            </MultiBinding>
                        </CheckBox.Visibility>
                    </CheckBox>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#191920"/>
                </Trigger>
                <!-- Only a sensor one of Pulse's readings comes from has switches. -->
                <DataTrigger Binding="{Binding Reading}" Value="{x:Null}">
                    <Setter TargetName="OverlaySwitch" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Reading.IsAvailable}" Value="False">
                    <Setter TargetName="OverlaySwitch" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ A PART'S PAGE ═══ -->
        <DataTemplate x:Key="PartPage">
            <StackPanel Margin="32,24,30,12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="9" Height="9" CornerRadius="2.5" Background="{Binding Accent}"
                            VerticalAlignment="Center" Margin="0,2,10,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                </StackPanel>
                <TextBlock Text="{Binding Model}" FontSize="12" Foreground="{StaticResource Text2}"
                           Margin="19,3,0,20" TextTrimming="CharacterEllipsis"/>

                <!-- The part's main reading, large, with its scale: what you came to this page for. -->
                <Border CornerRadius="10" Background="{StaticResource Raised}" Padding="20,16,16,14" Margin="0,0,8,24">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                            <Binding Path="DataContext.ShowPart" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="HasHero"/>
                        </MultiBinding>
                    </Border.Visibility>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeroLabel}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Text2}"/>
                            <TextBlock Margin="0,2,0,0">
                                <Run Text="{Binding HeroValue, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
                                <Run Text="{Binding HeroUnit, Mode=OneWay}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Text3}"/>
                            </TextBlock>
                            <TextBlock Text="Last minute" FontSize="10.5" Foreground="{StaticResource Text3}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <local:Sparkline Grid.Column="1" Height="112" Values="{Binding HeadlineHistory}"
                                         Minimum="{Binding HeroMin}" Maximum="{Binding HeroMax}" ShowGuides="True"
                                         Stroke="{StaticResource Accent}"/>
                        <Grid Grid.Column="2" Margin="12,0,0,0" Height="112">
                            <TextBlock Text="{Binding HeroTop}" FontSize="10" Foreground="{StaticResource Text3}" VerticalAlignment="Top" Margin="0,-3,0,0"/>
                            <TextBlock Text="{Binding HeroBottom}" FontSize="10" Foreground="{StaticResource Text3}" VerticalAlignment="Bottom" Margin="0,0,0,-3"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Pulse's readings for this part, each with its switches. -->
                <StackPanel>
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                            <Binding Path="HasReadings"/>
                            <Binding Path="AnyReadingShown"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <DockPanel Margin="0,0,10,10">
                        <TextBlock Text="Switch a reading on to show it on your overlay" DockPanel.Dock="Right"
                                   FontSize="10.5" Foreground="{StaticResource Text3}"/>
                        <TextBlock Text="PULSE'S READINGS" Style="{StaticResource Caption}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Readings}" ItemTemplate="{StaticResource ReadingCard}"
                                  ItemContainerStyle="{StaticResource ShownWhileVisible}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><local:ResponsiveGrid MinColumnWidth="215"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- A sleeping card is not read, so it can stay asleep. -->
                <Border CornerRadius="10" Background="{StaticResource Raised}" Padding="18,14"
                        Margin="0,0,8,20" Visibility="{Binding Asleep, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2}"
                               Text="This graphics card is asleep. Pulse doesn't read it while it sleeps, so it can stay asleep and save power. Its sensors show here when it wakes."/>
                </Border>

                <!-- Every sensor on this part's hardware, grouped by kind. -->
                <StackPanel Visibility="{Binding HasSensors, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0">
                    <DockPanel Margin="0,0,2,10">
                        <TextBlock Text="Lowest and highest since this window opened" DockPanel.Dock="Right"
                                   FontSize="10.5" Foreground="{StaticResource Text3}"/>
                        <TextBlock Text="EVERY SENSOR" Style="{StaticResource Caption}"/>
                    </DockPanel>
                    <Border CornerRadius="10" Background="{StaticResource Raised}" Padding="0,8,0,8">
                        <StackPanel>
                            <Grid Margin="16,2,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SENSOR" Style="{StaticResource ColumnHead}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="NOW" Style="{StaticResource ColumnHead}"/>
                                <TextBlock Grid.Column="2" Text="LOWEST" Style="{StaticResource ColumnHead}"/>
                                <TextBlock Grid.Column="3" Text="HIGHEST" Style="{StaticResource ColumnHead}"/>
                                <TextBlock Grid.Column="4" Text="LAST MINUTE" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center" Margin="16,0,0,0"/>
                                <TextBlock Grid.Column="5" Text="OVERLAY" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="IN GAME" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center"
                                           Visibility="{Binding DataContext.ShowInGameSwitches, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <Border Height="1" Background="{StaticResource LineSoft}"/>
                            <ItemsControl ItemsSource="{Binding Nodes}" ItemContainerStyle="{StaticResource ShownWhileVisible}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"
                                                       Margin="16,14,12,0"
                                                       Visibility="{Binding DataContext.ManyNodes, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding Sections}" ItemContainerStyle="{StaticResource ShownWhileVisible}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Text3}" Margin="16,12,12,3"/>
                                                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorRowTemplate}"
                                                                          ItemContainerStyle="{StaticResource ShownWhileVisible}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ═══ A PART'S OVERVIEW CARD ═══ -->
        <DataTemplate x:Key="PartCard">
            <Button Style="{StaticResource PartCardBtn}" Click="Part_Click"
                    AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}">
                <StackPanel x:Name="Body">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding More}" FontSize="11" Foreground="{StaticResource Text3}"
                                   VerticalAlignment="Center"/>
                        <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text1}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Model}" FontSize="11" Foreground="{StaticResource Text3}" Margin="17,2,0,14"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HeroLabel}" FontSize="11" Foreground="{StaticResource Text2}"/>
                    <TextBlock Margin="0,0,0,6">
                        <Run Text="{Binding HeroValue, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Text1}"/>
                        <Run Text="{Binding HeroUnit, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text3}"/>
                    </TextBlock>
                    <local:Sparkline Height="38" Values="{Binding HeadlineHistory}" Minimum="{Binding HeroMin}" Maximum="{Binding HeroMax}"
                                     Stroke="{StaticResource Accent}" Margin="0,0,0,14"/>
                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding KeyRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Asleep}" Value="True">
                    <Setter TargetName="Body" Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ WINDOW SHELL ═══ -->
    <Border x:Name="WindowBorder" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Line}"
            Background="{StaticResource Base}"
            TextElement.FontFamily="{StaticResource Jakarta}" TextElement.Foreground="{StaticResource Text1}"
            Typography.NumeralAlignment="Tabular">
        <Grid x:Name="ShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0" Background="{StaticResource Base}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- One down: centred on the capitals, not the line (owner, 27 Nov 2026). -->
                        <Ellipse Width="7" Height="7" Fill="#8B5CF6" VerticalAlignment="Center" Margin="0,1,9,0"/>
                        <TextBlock Text="Pulse" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}" VerticalAlignment="Center"/>
                        <TextBlock Text="  /  Sensors" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 32 high, as tall as the title bar's buttons allow and the same as the part list's
                         entries (owner, 27 Nov 2026: the box was 26 with its text 15, too low). -->
                    <Border Grid.Column="2" Width="300" Height="32" Background="{StaticResource Inset}" CornerRadius="8" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" Padding="11,0" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Text3}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="20,0,0,0" Padding="0" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Text1}" CaretBrush="{StaticResource Accent}" FontSize="12"
                                     AutomationProperties.Name="Search every sensor by name or kind"/>
                            <DockPanel Margin="22,0,0,0" IsHitTestVisible="False">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <Border DockPanel.Dock="Right" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl F" FontSize="9.5" Foreground="{StaticResource Text3}"/>
                                </Border>
                                <TextBlock Text="Search sensors" FontSize="12" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DotBtn}" Background="#FFBD2E"
                                AutomationProperties.Name="Minimize the Sensors window"
                                Click="BtnMinimize_Click" Margin="0,0,4,0" ToolTip="Minimize">
                            <TextBlock Text="─" FontSize="6" FontWeight="Black" Foreground="#7F4000" Margin="0,1,0,0"/>
                        </Button>
                        <Button Style="{StaticResource DotBtn}" Background="#FF5F57"
                                AutomationProperties.Name="Close the Sensors window"
                                Click="BtnClose_Click" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="6" FontWeight="Black" Foreground="#7F0014" Margin="0,0.5,0,0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ SIDEBAR: the parts of this PC ═══ -->
                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0" Background="{StaticResource Base}">
                    <DockPanel Margin="12,14,12,14">
                        <TextBlock DockPanel.Dock="Bottom" Text="Lowest, highest and the graphs start when this window opens."
                                   TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Text3}" Margin="10,10,4,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Click="Overview_Click" AutomationProperties.Name="Overview of every part">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SideItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverviewSelected}" Value="True">
                                                    <Setter Property="Tag" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        <TextBlock Text="Overview"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="PARTS" Style="{StaticResource Caption}" FontSize="9.5" Margin="10,18,0,8"/>
                                <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Part_Click" AutomationProperties.Name="{Binding Title}"
                                                    ToolTip="{Binding Model}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SideItem}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Tag" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Headline}" FontSize="11.5"
                                                               Foreground="{StaticResource Text3}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <Border Width="7" Height="7" CornerRadius="2" Background="{Binding Accent}"
                                                            VerticalAlignment="Center" Margin="2,0,12,0"/>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ═══ CONTENT ═══ -->
                <Grid Grid.Column="1">
                    <TextBlock Text="Reading every sensor..." FontSize="12" Foreground="{StaticResource Text3}" Margin="32,26,0,0"
                               Visibility="{Binding Waiting, Converter={StaticResource BoolToVis}}"/>

                    <!-- The overview: one card per part. -->
                    <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="32,24,20,16">
                            <TextBlock Text="Overview" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text1}"/>
                            <TextBlock Text="Every part of this PC at a glance. Open one for all its sensors, and to put a reading on your overlay."
                                       FontSize="12" Foreground="{StaticResource Text2}" Margin="0,3,12,22" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><local:ResponsiveGrid MinColumnWidth="260"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- One part. -->
                    <ScrollViewer x:Name="PartScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowPart, Converter={StaticResource BoolToVis}}">
                        <ContentPresenter Content="{Binding SelectedPart}" ContentTemplate="{StaticResource PartPage}"/>
                    </ScrollViewer>

                    <!-- Search: every part with anything that matches. -->
                    <ScrollViewer x:Name="SearchScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Search, StringFormat='Sensors matching “{0}”'}" FontSize="12"
                                       Foreground="{StaticResource Text3}" Margin="32,20,0,0"/>
                            <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartPage}"
                                          ItemContainerStyle="{StaticResource ShownWhileVisible}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
