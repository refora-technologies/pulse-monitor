<Window x:Class="Pulse.Views.SensorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Pulse.Converters"
        xmlns:local="clr-namespace:Pulse.Views"
        Title="Pulse — Sensors"
        Width="1080" Height="720"
        MinWidth="780" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- The Sensors window (owner's choice of the mockups, 26 Nov 2026): the parts of the PC down
         the left, an overview of every part as the front page, and for each part Pulse's own
         readings with their overlay switches, then every sensor it reports. -->

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/Views/PulseStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVis"/>

        <!-- ═══ SMALL SWITCH, for the cards and the sensor rows ═══ -->
        <Style x:Key="MiniToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="32" Height="18" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="9" BorderThickness="1" Background="#12102A" BorderBrush="#2A2648"/>
                            <Border x:Name="Thumb" Width="12" Height="12" CornerRadius="6" Background="#5C597E"
                                    HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#6D28D9"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8B5CF6"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="17,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#C4B5FD"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SIDEBAR ENTRY ═══ -->
        <Style x:Key="SideItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#A9A4CE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151230"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ OVERVIEW CARD (a button: opens the part) ═══ -->
        <Style x:Key="PartCardBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="#111020" BorderBrush="#1C1A30"
                                BorderThickness="1" Padding="16,14,16,13">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B21B6"/>
                                <Setter TargetName="Bd" Property="Background" Value="#131028"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A9A4CE"/>
        </Style>
        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6E6A96"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Shown only while the item is, for the search. -->
        <Style x:Key="ShownWhileVisible" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </Style>

        <!-- ═══ ONE OF PULSE'S READINGS: value, last minute, switches ═══
             The switches are the tile lists' own items (TileSelectionItem), so this window and
             the lists cannot disagree. -->
        <DataTemplate x:Key="ReadingCard">
            <Border x:Name="Card" Margin="0,0,10,10" CornerRadius="12" Background="#111020" BorderBrush="#1C1A30"
                    BorderThickness="1" Padding="14,11,14,10" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="5" Background="#1C1540" Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ADVANCED" FontSize="8.5" FontWeight="Bold" Foreground="#A78BFA"/>
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold" Foreground="#A9A4CE"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Margin="0,3,0,4" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Value, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{Binding ValueBrush, Mode=OneWay}"/>
                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="#8B86B4"/>
                    </TextBlock>
                    <local:Sparkline Grid.Row="2" Values="{Binding History}"
                                     Stroke="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     Visibility="{Binding IsCores, Converter={StaticResource InverseBoolToVis}}"/>
                    <local:CoreBars Grid.Row="2" Loads="{Binding CoreLoads}" BarWidth="5" HorizontalAlignment="Left"
                                    Visibility="{Binding IsCores, Converter={StaticResource BoolToVis}}"/>
                    <Grid Grid.Row="3" Margin="0,9,0,0" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Overlay" FontSize="10.5" Foreground="#8B86B4" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <CheckBox Style="{StaticResource MiniToggle}" IsChecked="{Binding Overlay.IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} on the overlay'}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                    <Binding Path="DataContext.ShowInGameSwitches" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="HasInGame"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="In game" FontSize="10.5" Foreground="#8B86B4" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <CheckBox Style="{StaticResource MiniToggle}" IsChecked="{Binding InGame.IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} in game'}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Margin="0,9,0,0" Text="Not on this PC" FontSize="10.5" Foreground="#7D78A6"
                               ToolTip="{Binding Unavailable}"
                               Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ ONE SENSOR ROW ═══ -->
        <DataTemplate x:Key="SensorRowTemplate">
            <Border x:Name="Row" Padding="14,6,10,6" BorderBrush="#17152A" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="#C9C5E6"/>
                        <Run Text="{Binding Tile, Mode=OneWay}" Foreground="#A78BFA" FontSize="10"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Run Text="{Binding Now, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F2FC"/>
                        <Run Text="{Binding Unit, Mode=OneWay}" FontSize="10" Foreground="#6E6A96"/>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Low}" FontSize="11.5" Foreground="#8B86B4"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding High}" FontSize="11.5" Foreground="#8B86B4"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <local:Sparkline Grid.Column="4" Values="{Binding History}" Height="18" Margin="18,0,4,0"
                                     Stroke="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"/>
                    <CheckBox x:Name="OverlaySwitch" Grid.Column="5" Style="{StaticResource MiniToggle}" HorizontalAlignment="Center"
                              IsChecked="{Binding Reading.Overlay.IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Reading.Label, StringFormat='{}{0} on the overlay'}"/>
                    <CheckBox x:Name="InGameSwitch" Grid.Column="6" Style="{StaticResource MiniToggle}" HorizontalAlignment="Center"
                              IsChecked="{Binding Reading.InGame.IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Reading.Label, StringFormat='{}{0} in game'}">
                        <CheckBox.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                <Binding Path="DataContext.ShowInGameSwitches" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="Reading.IsAvailable"/>
                                <Binding Path="Reading.HasInGame"/>
                            </MultiBinding>
                        </CheckBox.Visibility>
                    </CheckBox>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#141229"/>
                </Trigger>
                <!-- Only a sensor one of Pulse's readings comes from has switches. -->
                <DataTrigger Binding="{Binding Reading}" Value="{x:Null}">
                    <Setter TargetName="OverlaySwitch" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Reading.IsAvailable}" Value="False">
                    <Setter TargetName="OverlaySwitch" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ A PART'S PAGE ═══ -->
        <DataTemplate x:Key="PartPage">
            <StackPanel Margin="28,22,26,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Accent}"
                            VerticalAlignment="Center" Margin="0,2,11,0"/>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="ExtraBold" Foreground="#F0EEF8"/>
                    <Border CornerRadius="10" Background="#1C1540" Padding="10,3" Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}" FontSize="12" FontWeight="Bold" Foreground="#C4B5FD"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Model}" FontSize="11.5" FontWeight="Medium" Foreground="#8B86B4"
                           Margin="23,3,0,18" TextTrimming="CharacterEllipsis"/>

                <!-- Pulse's readings for this part, as cards with their switches. -->
                <StackPanel>
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                            <Binding Path="HasReadings"/>
                            <Binding Path="AnyReadingShown"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <DockPanel Margin="1,0,12,9">
                        <TextBlock Text="Switch one on to show it on your overlay" DockPanel.Dock="Right"
                                   FontSize="10.5" Foreground="#6E6A96"/>
                        <TextBlock Text="PULSE'S READINGS" Style="{StaticResource SectionLabel}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Readings}" ItemTemplate="{StaticResource ReadingCard}"
                                  ItemContainerStyle="{StaticResource ShownWhileVisible}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><local:ResponsiveGrid MinColumnWidth="215"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- A sleeping card is not read, so it can stay asleep. -->
                <Border CornerRadius="12" Background="#111020" BorderBrush="#1C1A30" BorderThickness="1" Padding="16,14"
                        Margin="0,0,10,14" Visibility="{Binding Asleep, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#A9A4CE"
                               Text="This graphics card is asleep. Pulse doesn't read it while it sleeps, so it can stay asleep and save power. Its sensors show here when it wakes."/>
                </Border>

                <!-- Every sensor on this part's hardware. -->
                <StackPanel Visibility="{Binding HasSensors, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                    <DockPanel Margin="1,0,2,8">
                        <TextBlock Text="Lowest and highest since this window opened" DockPanel.Dock="Right"
                                   FontSize="10.5" Foreground="#6E6A96"/>
                        <TextBlock Text="EVERY SENSOR" Style="{StaticResource SectionLabel}"/>
                    </DockPanel>
                    <Border CornerRadius="12" Background="#111020" BorderBrush="#1C1A30" BorderThickness="1" Padding="0,4,0,6">
                        <StackPanel>
                            <Grid Margin="14,4,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SENSOR" Style="{StaticResource ColumnHead}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="NOW" Style="{StaticResource ColumnHead}"/>
                                <TextBlock Grid.Column="2" Text="LOWEST" Style="{StaticResource ColumnHead}"/>
                                <TextBlock Grid.Column="3" Text="HIGHEST" Style="{StaticResource ColumnHead}"/>
                                <TextBlock Grid.Column="4" Text="LAST MINUTE" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="OVERLAY" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="IN GAME" Style="{StaticResource ColumnHead}" HorizontalAlignment="Center"
                                           Visibility="{Binding DataContext.ShowInGameSwitches, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Nodes}" ItemContainerStyle="{StaticResource ShownWhileVisible}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="#DBD7F2"
                                                       Margin="14,10,10,4"
                                                       Visibility="{Binding DataContext.ManyNodes, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorRowTemplate}"
                                                          ItemContainerStyle="{StaticResource ShownWhileVisible}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ═══ A PART'S OVERVIEW CARD ═══ -->
        <DataTemplate x:Key="PartCard">
            <Button Style="{StaticResource PartCardBtn}" Click="Part_Click"
                    AutomationProperties.Name="{Binding Title, StringFormat='Open {0}'}">
                <StackPanel x:Name="Body">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" CornerRadius="10" Background="#1C1540" Padding="9,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Headline}" FontSize="11.5" FontWeight="Bold" Foreground="#C4B5FD"/>
                        </Border>
                        <Border Width="9" Height="9" CornerRadius="2.5" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#F0EEF8"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Model}" FontSize="11" Foreground="#8B86B4" Margin="0,3,0,10"
                               TextTrimming="CharacterEllipsis"/>
                    <local:Sparkline Height="44" Values="{Binding HeadlineHistory}" Stroke="{Binding Accent}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding KeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" FontSize="11.5" FontWeight="SemiBold" Foreground="#DBD7F2"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="#A9A4CE" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding More, StringFormat='{}{0}  →'}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#A78BFA" Margin="0,9,0,0"/>
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Asleep}" Value="True">
                    <Setter TargetName="Body" Property="Opacity" Value="0.65"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ WINDOW SHELL ═══ -->
    <Border x:Name="WindowBorder" CornerRadius="18" BorderThickness="1" BorderBrush="#1C1A30"
            TextElement.FontFamily="{StaticResource Jakarta}" TextElement.Foreground="#EDE9FC">
        <Border.Background><SolidColorBrush Color="#0D0C16"/></Border.Background>
        <Grid x:Name="ShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0" CornerRadius="17,17,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border.Background><SolidColorBrush Color="#0B0A14" Opacity="0.85"/></Border.Background>
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#C4B5FD" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="PULSE" FontSize="11.5" FontWeight="ExtraBold" Foreground="#BDB5F5"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Sensors" FontSize="11" FontWeight="Medium" Foreground="#A9A4CE" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="2" Width="300" Background="#111020" CornerRadius="10" BorderBrush="#1C1A30"
                            BorderThickness="1" Padding="10,1" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#6E6A96"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="20,0,0,0" Padding="0,6" Background="Transparent" BorderThickness="0"
                                     Foreground="#DBD7F2" CaretBrush="#A78BFA" FontSize="12"
                                     AutomationProperties.Name="Search every sensor by name or kind"/>
                            <TextBlock Text="Search every sensor   (Ctrl+F)" Margin="22,0,0,0" FontSize="12" Foreground="#55517A"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource DotBtn}" Background="#FFBD2E"
                                AutomationProperties.Name="Minimize the Sensors window"
                                Click="BtnMinimize_Click" Margin="0,0,4,0" ToolTip="Minimize">
                            <TextBlock Text="─" FontSize="6" FontWeight="Black" Foreground="#7F4000" Margin="0,1,0,0"/>
                        </Button>
                        <Button Style="{StaticResource DotBtn}" Background="#FF5F57"
                                AutomationProperties.Name="Close the Sensors window"
                                Click="BtnClose_Click" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="6" FontWeight="Black" Foreground="#7F0014" Margin="0,0.5,0,0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="#161330"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ SIDEBAR: the parts of this PC ═══ -->
                <Border BorderBrush="#161330" BorderThickness="0,0,1,0" CornerRadius="0,0,0,17">
                    <Border.Background><SolidColorBrush Color="#0B0A14" Opacity="0.6"/></Border.Background>
                    <DockPanel Margin="12,14,12,14">
                        <TextBlock DockPanel.Dock="Bottom" Text="Lowest, highest and the graphs start when this window opens."
                                   TextWrapping="Wrap" FontSize="10.5" Foreground="#6E6A96" Margin="8,10,4,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Click="Overview_Click" AutomationProperties.Name="Overview of every part">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SideItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowOverview}" Value="True">
                                                    <Setter Property="Background" Value="#1C1540"/>
                                                    <Setter Property="Foreground" Value="#F0EEF8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#C4B5FD"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Overview"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#1C1A30" Margin="6,8,6,8"/>
                                <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Part_Click" AutomationProperties.Name="{Binding Title}"
                                                    ToolTip="{Binding Model}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SideItem}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1C1540"/>
                                                                <Setter Property="Foreground" Value="#F0EEF8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Headline}" FontSize="11"
                                                               FontWeight="Medium" Foreground="#8B86B4" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Accent}"
                                                            VerticalAlignment="Center" Margin="1,0,11,0"/>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ═══ CONTENT ═══ -->
                <Grid Grid.Column="1">
                    <TextBlock Text="Reading every sensor..." FontSize="12" Foreground="#8B86B4" Margin="28,24,0,0"
                               Visibility="{Binding Waiting, Converter={StaticResource BoolToVis}}"/>

                    <!-- The overview: one card per part. -->
                    <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowOverview, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="28,22,16,14">
                            <TextBlock Text="Overview" FontSize="22" FontWeight="ExtraBold" Foreground="#F0EEF8"/>
                            <TextBlock Text="Every part of this PC at a glance. Open one to see all its sensors and put a reading on your overlay."
                                       FontSize="11.5" FontWeight="Medium" Foreground="#8B86B4" Margin="0,3,12,18" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><local:ResponsiveGrid MinColumnWidth="250"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- One part. -->
                    <ScrollViewer x:Name="PartScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowPart, Converter={StaticResource BoolToVis}}">
                        <ContentPresenter Content="{Binding SelectedPart}" ContentTemplate="{StaticResource PartPage}"/>
                    </ScrollViewer>

                    <!-- Search: every part with anything that matches. -->
                    <ScrollViewer x:Name="SearchScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Searching, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Search, StringFormat='Sensors matching “{0}”'}" FontSize="12"
                                       Foreground="#8B86B4" Margin="28,18,0,0"/>
                            <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartPage}"
                                          ItemContainerStyle="{StaticResource ShownWhileVisible}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
