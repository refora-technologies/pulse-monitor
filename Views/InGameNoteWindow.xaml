<Window x:Class="Pulse.Views.InGameNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Show Pulse inside games"
        Width="460" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>

        <Style x:Key="DialogAccentBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="20,11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#A78BFA" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#8E8AB0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,11"
                                Background="#0E0C1C" BorderBrush="#241F42" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A2870"/>
                                <Setter Property="Foreground" Value="#C4B5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Asked once, when the in-game overlay is turned on: what it does, where it does not, and
         that it can be turned off. Answered with a button, not just closed. -->
    <Border CornerRadius="17" BorderThickness="1" BorderBrush="#241F42"
            TextElement.FontFamily="{StaticResource Jakarta}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#15111F" Offset="0"/>
                <GradientStop Color="#0B0A14" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.5" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="24,22,24,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="IN-GAME OVERLAY" FontSize="10" FontWeight="Bold"
                               Foreground="#A9A4CE" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Show Pulse inside games" FontSize="19" FontWeight="ExtraBold"
                           Foreground="#F0EEF8"/>
                <Border Height="1" Background="#1A1830" Margin="0,14,0,14"/>

                <TextBlock FontSize="11.5" FontWeight="Medium" Foreground="#A6A2C6" TextWrapping="Wrap"
                           LineHeight="17" Margin="0,0,0,10"
                           Text="Pulse will draw its overlay inside your games, so it stays visible in full-screen games too. To do that, a small part of Pulse runs inside the game. It only draws your readings: it never reads or changes the game."/>

                <Border Background="#2A2210" CornerRadius="9" Padding="12,9" Margin="0,0,0,10">
                    <TextBlock FontSize="11.5" FontWeight="Medium" Foreground="#F5C46B" TextWrapping="Wrap"
                               LineHeight="17"
                               Text="It does not work in games with anti-cheat, for example Valorant, Fortnite, Apex Legends or Counter-Strike 2. In those games Pulse keeps showing the window overlay, so your account stays safe."/>
                </Border>

                <TextBlock FontSize="11.5" FontWeight="Medium" Foreground="#A6A2C6" TextWrapping="Wrap"
                           LineHeight="17" Margin="0,0,0,14"
                           Text="Pulse is not signed, so some antivirus programs may question it. You can turn this off at any time."/>
            </StackPanel>

            <Border CornerRadius="0,0,17,17" Padding="24,16"
                    BorderBrush="#1A1830" BorderThickness="0,1,0,0">
                <Border.Background><SolidColorBrush Color="#0B0A14" Opacity="0.85"/></Border.Background>
                <Grid>
                    <Button Content="Cancel" HorizontalAlignment="Left" IsCancel="True"
                            Style="{StaticResource DialogGhostBtn}" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnTurnOn" Content="Turn on" HorizontalAlignment="Right"
                            Style="{StaticResource DialogAccentBtn}" Click="BtnTurnOn_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
