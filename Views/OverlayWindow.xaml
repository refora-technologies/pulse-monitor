<Window x:Class="Pulse.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Pulse.ViewModels"
        xmlns:conv="clr-namespace:Pulse.Converters"
        xmlns:views="clr-namespace:Pulse.Views"
        Title="Pulse Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="{Binding OverlayOpacity}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <conv:PercentToWidthConverter x:Key="BarWidthConv"/>

        <!-- ═══ RIGHT-CLICK MENU (drag mode) ═══ -->
        <Style x:Key="OverlayContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6"
                                                   Opacity="0.45" Direction="270"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource VioletTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- No padding: this used to inset the panel 6px inside the window on every side. The
         padding is transparent and, with no background on this border, not even
         hit-testable, so it bought nothing - but it meant the window was 12px larger
         than the panel on screen. Every position we reported described that invisible
         box, and dragging into a corner left a 6px gap that could not be closed. -->
    <Border x:Name="DragBorder" Padding="0" TextElement.FontFamily="{StaticResource Jakarta}">
        <Grid>
        <!-- Scaled content lives in its own Grid so the resize grip below (a sibling,
             outside this transform) stays a constant, easily-grabbable size regardless
             of the current scale. LayoutTransform (not RenderTransform) is required so
             the window's SizeToContent measures the post-scale size correctly. -->
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding OverlayScale}" ScaleY="{Binding OverlayScale}"/>
            </Grid.LayoutTransform>

            <!-- ═══ NORMAL MODE ═══ -->
            <!-- The fade is applied to the brushes, never to the Border itself: fading the
                 element would take the readings down with it, and keeping those legible while
                 the panel disappears is the entire point.

                 BorderBrush is bound as a whole brush because a Border does not give its
                 BorderBrush a data context, so a binding written inside that brush silently
                 never resolves and Opacity stays at 1. -->
            <!-- Against a screen edge, the panel joins it (EdgePanel, owner 26 Nov 2026). -->
            <views:EdgePanel x:Name="NormalPanel" CornerRadius="18" FlareRadius="10"
                    BorderBrush="{Binding NormalBorderBrush}">
                <views:EdgePanel.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1"
                                         Opacity="{Binding NormalPanelOpacity}">
                        <GradientStop Color="#17122C" Offset="0"/>
                        <GradientStop Color="#0C0A18" Offset="1"/>
                    </LinearGradientBrush>
                </views:EdgePanel.Background>
                <!-- 288 to 334 wide with the margins, as before. -->
                <StackPanel Margin="16,14,16,12" MinWidth="256" MaxWidth="302">
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.95"
                                                      Color="{Binding StatusColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="PULSE" FontSize="12" FontWeight="ExtraBold"
                                       Foreground="#C4B5FD" VerticalAlignment="Center"/>
                            <TextBlock Text="MONITOR" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="#A9A4CE" VerticalAlignment="Center"
                                       Margin="6,1,0,0"/>
                        </StackPanel>
                        <TextBlock Text="⠿" FontSize="13" Foreground="#A78BFA"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding IsDragEnabled, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Accent divider. Fades with the background, because it is decoration
                         rather than a reading: at zero the setting promises just the readings,
                         and a violet line across the top is not one of them. -->
                    <Border Height="1.5" Margin="0,0,0,12" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"
                                                 Opacity="{Binding NormalPanelOpacity}">
                                <GradientStop Color="#A855F7" Offset="0"/>
                                <GradientStop Color="#3A2D5C" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Sensor tiles — 2 column grid -->
                    <ItemsControl ItemsSource="{Binding ActiveTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileViewModel}">
                                <!-- Card and outline both follow the background setting, so
                                     turning it all the way down really does leave only the
                                     readings. Taken from the view model as finished brushes:
                                     a brush written inside BorderBrush gets no data context
                                     and its bindings never resolve. -->
                                <Border CornerRadius="12" Margin="3,3" Padding="13,9,13,10"
                                        BorderThickness="1"
                                        Background="{Binding DataContext.TileFillBrush,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                        BorderBrush="{Binding DataContext.TileBorderBrush,
                                                     RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#928EB4" VerticalAlignment="Center"/>
                                            <views:PowerGlyph Power="{Binding Power}" Level="{Binding Value}" LevelBrush="{Binding ValueBrush}"
                                                              Height="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                                              Visibility="{Binding ShowsPower, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <!-- CPU Cores: a bar per core where the number would be,
                                             the height of the number it replaces. -->
                                        <views:CoreBars Loads="{Binding CoreLoads}" BarWidth="4" Height="27"
                                                        HorizontalAlignment="Left" Margin="0,2,0,2"
                                                        Visibility="{Binding ShowsCoreBars, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                                    Visibility="{Binding ShowsCoreBars, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding DisplayValue}"
                                                       FontSize="23" FontWeight="Bold"
                                                       Foreground="{Binding ValueBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                                      Opacity="0.55"
                                                                      Color="{Binding ValueColor}"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#8E8AB0"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,3">
                                                <Run Text="{Binding DisplayUnit, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid Margin="0,6,0,0"
                                              Visibility="{Binding Definition.HasBar, Converter={StaticResource BoolToVis}}">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{Binding DataContext.TileBarTrackBrush,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Border Height="4" CornerRadius="2" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource BarWidthConv}">
                                                        <Binding Path="BarFraction"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid}"
                                                                 Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding ValueColor}"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVis}}">
                        <!-- Same again for the line above the status row. -->
                        <Border Height="1" Margin="0,8,0,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"
                                                     Opacity="{Binding NormalPanelOpacity}">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#2A2548" Offset="0.5"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7"
                                                      Color="{Binding StatusColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       FontSize="10.5" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </views:EdgePanel>

            <!-- ═══ COMPACT HUD MODE ═══ -->
            <views:EdgePanel x:Name="CompactPanel" CornerRadius="12" FlareRadius="8" Visibility="Collapsed"
                    BorderBrush="{Binding CompactBorderBrush}">
                <views:EdgePanel.Background>
                    <SolidColorBrush Color="#0C0A18" Opacity="{Binding CompactPanelOpacity}"/>
                </views:EdgePanel.Background>
                <StackPanel Margin="14,10,14,9" MinWidth="144">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding StatusColor}"/>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8"
                                                  Color="{Binding StatusColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="PULSE" FontSize="9" FontWeight="ExtraBold"
                                   Foreground="#A9A4CE" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ActiveTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileViewModel}">
                                <Grid Margin="0,2.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" LastChildFill="False">
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="#9692B8"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <views:PowerGlyph Power="{Binding Power}" Level="{Binding Value}" LevelBrush="{Binding ValueBrush}"
                                                          Height="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{Binding ShowsPower, Converter={StaticResource BoolToVis}}"/>
                                    </DockPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayValue}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding ValueBrush}"
                                               HorizontalAlignment="Left"
                                               Margin="10,0,4,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding ShowsCoreBars, Converter={StaticResource InverseBoolToVis}}"/>
                                    <views:CoreBars Grid.Column="1" Loads="{Binding CoreLoads}" BarWidth="3" Height="12"
                                                    Margin="10,0,4,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowsCoreBars, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayUnit}"
                                               FontSize="10" Foreground="#8E8AB0"
                                               FontWeight="Medium"
                                               VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </views:EdgePanel>

            <!-- ═══ COMPACT, STRAIGHT ═══ The in-game overlay's "straight way" (4 Nov) on the
                 desktop (owner, 26 Nov 2026): every reading on one line, label, value and unit,
                 with a thin divider between. Same panel, fonts and colours as the compact list. -->
            <views:EdgePanel x:Name="BarPanel" CornerRadius="12" FlareRadius="8" Visibility="Collapsed"
                    BorderBrush="{Binding CompactBorderBrush}">
                <views:EdgePanel.Background>
                    <SolidColorBrush Color="#0C0A18" Opacity="{Binding CompactPanelOpacity}"/>
                </views:EdgePanel.Background>
                <!-- Readings only, no status dot, as in games (owner, 27 Nov 2026). -->
                <StackPanel Orientation="Horizontal" Margin="14,8,14,8">
                    <ItemsControl ItemsSource="{Binding ActiveTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Divider" Width="1" Height="11" Margin="11,0" Background="#2A2548"
                                            VerticalAlignment="Center"
                                            Opacity="{Binding DataContext.CompactPanelOpacity, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="11" FontWeight="Medium"
                                               Foreground="#9692B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <views:PowerGlyph Power="{Binding Power}" Level="{Binding Value}" LevelBrush="{Binding ValueBrush}"
                                                      Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      Visibility="{Binding ShowsPower, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding ValueBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding ShowsCoreBars, Converter={StaticResource InverseBoolToVis}}"/>
                                    <views:CoreBars Loads="{Binding CoreLoads}" BarWidth="3" Height="12" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowsCoreBars, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DisplayUnit}" FontSize="10" Foreground="#8E8AB0" FontWeight="Medium"
                                               VerticalAlignment="Bottom" Margin="3,0,0,1"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <!-- No divider before the first reading. -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Divider" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </views:EdgePanel>
        </Grid>

        <!-- ═══ RESIZE GRIP ═══ Only reachable in Free Drag mode, same as the move
             affordance above — the locked/default experience never shows this. -->
        <Thumb x:Name="ResizeGrip" Width="18" Height="18"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Visibility="{Binding IsDragEnabled, Converter={StaticResource BoolToVis}}"
               DragStarted="OnResizeDragStarted"
               DragDelta="OnResizeDragDelta"
               DragCompleted="OnResizeDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Margin="0,0,2,2">
                        <Path Data="M 14,2 L 14,14 L 2,14" Stroke="#8B5CF6" StrokeThickness="1.75"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Opacity="0.85"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        </Grid>
    </Border>
</Window>
