<Window x:Class="Pulse.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Pulse.ViewModels"
        xmlns:conv="clr-namespace:Pulse.Converters"
        Title="Pulse Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/Icons/pulse.ico"
        SizeToContent="WidthAndHeight"
        Opacity="{Binding OverlayOpacity}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <conv:PercentToWidthConverter x:Key="BarWidthConv"/>

        <!-- ═══ RIGHT-CLICK MENU (drag mode) ═══ -->
        <Style x:Key="OverlayContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="{StaticResource Jakarta}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6"
                                                   Opacity="0.45" Direction="270"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource VioletTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DragBorder" Padding="6" TextElement.FontFamily="{StaticResource Jakarta}">
        <Grid>
        <!-- Scaled content lives in its own Grid so the resize grip below (a sibling,
             outside this transform) stays a constant, easily-grabbable size regardless
             of the current scale. LayoutTransform (not RenderTransform) is required so
             the window's SizeToContent measures the post-scale size correctly. -->
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding OverlayScale}" ScaleY="{Binding OverlayScale}"/>
            </Grid.LayoutTransform>

            <!-- ═══ NORMAL MODE ═══ -->
            <Border x:Name="NormalPanel" CornerRadius="18"
                    MinWidth="288" MaxWidth="334"
                    BorderThickness="1">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#8B5CF6" Opacity="0.22"/>
                </Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                        <GradientStop Color="#17122C" Offset="0"/>
                        <GradientStop Color="#0C0A18" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="16,14,16,12">
                    <!-- Header -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.95"
                                                      Color="{Binding StatusColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="PULSE" FontSize="12" FontWeight="ExtraBold"
                                       Foreground="#C4B5FD" VerticalAlignment="Center"/>
                            <TextBlock Text="MONITOR" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="#5A5578" VerticalAlignment="Center"
                                       Margin="6,1,0,0"/>
                        </StackPanel>
                        <TextBlock Text="⠿" FontSize="13" Foreground="#8B5CF6"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding IsDragEnabled, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Accent divider -->
                    <Border Height="1.5" Margin="0,0,0,12" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A855F7" Offset="0"/>
                                <GradientStop Color="#3A2D5C" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Sensor tiles — 2 column grid -->
                    <ItemsControl ItemsSource="{Binding ActiveTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileViewModel}">
                                <Border CornerRadius="12" Margin="3,3" Padding="13,9,13,10"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#1A1632"/>
                                    </Border.Background>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#2A2548"/>
                                    </Border.BorderBrush>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Definition.Label}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#928EB4" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DisplayValue}"
                                                       FontSize="23" FontWeight="Bold"
                                                       Foreground="{Binding ValueBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                                      Opacity="0.55"
                                                                      Color="{Binding ValueColor}"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#8E8AB0"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Bottom" Margin="4,0,0,3">
                                                <Run Text="{Binding Definition.Unit, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Grid Margin="0,6,0,0"
                                              Visibility="{Binding Definition.HasBar, Converter={StaticResource BoolToVis}}">
                                            <Border Height="4" CornerRadius="2" Background="#2A2A3A"/>
                                            <Border Height="4" CornerRadius="2" HorizontalAlignment="Left">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource BarWidthConv}">
                                                        <Binding Path="BarFraction"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Grid}"
                                                                 Path="ActualWidth"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding ValueColor}"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding ShowStatusBar, Converter={StaticResource BoolToVis}}">
                        <Border Height="1" Margin="0,8,0,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#2A2548" Offset="0.5"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7"
                                                      Color="{Binding StatusColor}"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       FontSize="10.5" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ COMPACT HUD MODE ═══ -->
            <Border x:Name="CompactPanel" CornerRadius="12" Visibility="Collapsed" MinWidth="172"
                    BorderThickness="1">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#8B5CF6" Opacity="0.18"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="#0C0A18" Opacity="0.82"/>
                </Border.Background>
                <StackPanel Margin="14,10,14,9">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding StatusColor}"/>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8"
                                                  Color="{Binding StatusColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="PULSE" FontSize="9" FontWeight="ExtraBold"
                                   Foreground="#7C77A0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ActiveTiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TileViewModel}">
                                <Grid Margin="0,2.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Definition.Label}"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="#9692B8"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayValue}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding ValueBrush}"
                                               HorizontalAlignment="Left"
                                               Margin="10,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Definition.Unit}"
                                               FontSize="10" Foreground="#8E8AB0"
                                               FontWeight="Medium"
                                               VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ RESIZE GRIP ═══ Only reachable in Free Drag mode, same as the move
             affordance above — the locked/default experience never shows this. -->
        <Thumb x:Name="ResizeGrip" Width="18" Height="18"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Visibility="{Binding IsDragEnabled, Converter={StaticResource BoolToVis}}"
               DragDelta="OnResizeDragDelta"
               DragCompleted="OnResizeDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent" Margin="0,0,2,2">
                        <Path Data="M 14,2 L 14,14 L 2,14" Stroke="#8B5CF6" StrokeThickness="1.75"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Opacity="0.85"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        </Grid>
    </Border>
</Window>
