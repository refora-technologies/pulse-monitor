<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AvailabilityTest</AssemblyName>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The rules themselves, compiled in rather than reached by reflection: they are one
         file with no dependencies, and this way a renamed member fails the build loudly. -->
    <Compile Include="..\..\..\Models\TileAvailability.cs" Link="TileAvailability.cs" />
  </ItemGroup>
</Project>
